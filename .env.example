APP_ENV=local
INPUT_SOURCE=desktop_native_stable
DESKTOP_AUDIO_CAPTURE_MODE=desktop_native_stable
DESKTOP_NATIVE_INCLUDE_OWN_AUDIO=true
DESKTOP_NATIVE_CHUNK_FRAMES=4096
LIVE_ASSIST_DIAGNOSTICS_ENABLED=false
LIVE_ASSIST_CONFIG_FILE=config/live_assist.local.json

PYTHON_WS_SARVAM_API_KEY=replace_me
GROQ_API_KEY=replace_me
OPENAI_API_KEY=replace_me
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.example.com/v1
HF_TOKEN=

PYTHON_WS_PORT=8089
PYTHON_WS_SAMPLE_RATE=16000
PYTHON_WS_CHUNK_SIZE=1024
PYTHON_WS_BUFFER_CHUNKS=6
PYTHON_WS_ENERGY_THRESHOLD=100
PYTHON_WS_STT_SEND_RMS_FLOOR=0
PYTHON_WS_LOW_ENERGY_PACKET_TARGET=3
PYTHON_WS_MAX_UTTERANCE_SECONDS=20
PYTHON_WS_EXPERIMENTAL_ECHO_TOOLS=false
PYTHON_WS_ECHO_SUPPRESSION_ENABLED=false
PYTHON_WS_ECHO_STRONG_TEXT_SIMILARITY_THRESHOLD=0.78
PYTHON_WS_ECHO_WEAK_TEXT_SIMILARITY_THRESHOLD=0.60
PYTHON_WS_ECHO_WINDOW_SECONDS=2.5
PYTHON_WS_ECHO_MIN_TEXT_CHARS=4
PYTHON_WS_ECHO_SHORT_TEXT_MAX_CHARS=6
PYTHON_WS_ECHO_WORKER_DOMINANCE_RATIO=1.5
PYTHON_WS_MIC_BLEED_SUPPRESSION_ENABLED=false
PYTHON_WS_MIC_BLEED_WORKER_DOMINANCE_RATIO=1.4
PYTHON_WS_MIC_BLEED_INTERJECTION_CONFIRM_PACKETS=2
PYTHON_WS_MIC_BLEED_CUSTOMER_LEAD_PACKETS=2
PYTHON_WS_MIC_BLEED_MIN_WORKER_RMS=100
PYTHON_WS_SIMPLE_OVERLAP_SUPPRESSION_ENABLED=false
PYTHON_WS_SIMPLE_OVERLAP_PACKET_TARGET=3
LIVE_FEEDBACK_WEBHOOK_URL=http://127.0.0.1:8000/livefeedback/webhook
LIVE_FEEDBACK_WEBHOOK_TIMEOUT=60

ASR_PROVIDER=sarvam
TRANSLATION_PROVIDER=sarvam
LLM_PROVIDER=groq
RAG_PROVIDER=advanced
TRANSCRIPT_STORAGE=sqlite
STATE_STORAGE=sqlite

# ── Shared API keys ────────────────────────────────────────────────────────────
GROQ_API_KEY=replace_me
OPENAI_API_KEY=replace_me
GEMINI_API_KEY=replace_me          # used for VLM (figure/table description) + gemini embeddings

# Generic OpenAI-compatible key (used when LLM_API_KEY is set)
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.example.com/v1

# ── Legacy model config (still used when slot-specific vars are absent) ────────
CHROMA_DB_COLLECTION_NAME=finideas_collection
CHROMA_DB_PERSISTENT_DIRECTORY=./chroma_db
EMBEDDING_MODEL=BAAI/bge-m3
LLM_MODEL=llama-3.3-70b-versatile
LLM_STRUCTURED_OUTPUT_MODE=json_prompt  # json_prompt | native | native_fallback
TEMPERATURE=0

# ══ AI Provider Slots ═══════════════════════════════════════════════════════
# Three independent workload slots — each can point at a different endpoint.
# Leave all empty to keep legacy behavior (Groq for LLM, local for embeddings).
# Slot-specific vars take priority; fall back to shared keys above when absent.
#
# ── Slot 1: Live LLM (real-time query enrichment + answer generation) ─────────
# LIVE_LLM_PROVIDER=groq          # groq | openai | openai_compatible | gemini
# LIVE_LLM_MODEL=                 # overrides LLM_MODEL
# LIVE_LLM_BASE_URL=              # REQUIRED for openai_compatible
# LIVE_LLM_API_KEY=               # falls back to GROQ_API_KEY / OPENAI_API_KEY
# LIVE_LLM_TEMPERATURE=           # overrides TEMPERATURE
# LIVE_LLM_STRUCTURED_OUTPUT_MODE= # overrides LLM_STRUCTURED_OUTPUT_MODE
#
# ── Slot 2: Context LLM (ingestion contextual prefix generation) ───────────────
# CONTEXT_LLM_PROVIDER=groq       # groq | openai | openai_compatible | gemini | ollama
# CONTEXT_LLM_MODEL=              # overrides GENERATION_MODEL / LLM_MODEL
# CONTEXT_LLM_BASE_URL=           # REQUIRED for openai_compatible
# CONTEXT_LLM_API_KEY=            # falls back to GROQ_API_KEY / OPENAI_API_KEY
#
# ── Slot 2b: Context VLM (figure/table description — extends PARSER_VLM_*) ────
# PARSER_VLM_PROVIDER=gemini      # gemini | openai | openai_compatible | ollama
# PARSER_VLM_MODEL=gemini-2.0-flash
# PARSER_VLM_BASE_URL=            # REQUIRED for openai_compatible
# PARSER_VLM_API_KEY=             # falls back to GEMINI_API_KEY
#
# ── Slot 3: Embeddings (semantic search + cache + ingestion vectors) ───────────
# EMBEDDING_PROVIDER=local        # local | openai | openai_compatible | gemini | cohere
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BASE_URL=             # REQUIRED for openai_compatible
# EMBEDDING_API_KEY=              # required for cloud providers
#
# ── RunPod vLLM example (all three slots to same RunPod pod) ──────────────────
# LIVE_LLM_PROVIDER=openai_compatible
# LIVE_LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# LIVE_LLM_MODEL=<served-model-name>
# CONTEXT_LLM_PROVIDER=openai_compatible
# CONTEXT_LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# CONTEXT_LLM_MODEL=<served-model-name>
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://<pod-id>-8001.proxy.runpod.net/v1
# EMBEDDING_MODEL=<embedding-model-name>
# ═══════════════════════════════════════════════════════════════════════════

LIVE_FEEDBACK_SQLITE_PATH=data/live_feedback.sqlite3
MEMORY_SQLITE_PATH=data/finideas_memory.sqlite3
LIVE_FEEDBACK_USER_ID=user_01
LIVE_FEEDBACK_MIN_CUSTOMER_WORKFLOW_CHARS=15

ENABLE_MCP_SERVER_TOOLS=false
ENABLE_MCP_CLIENT_TOOLS=false
ENABLE_MEMORY=false
ENABLE_ENTITY_EXTRACTION=false
ENABLE_CRM_INTEGRATION=false
ENABLE_CALENDAR_INTEGRATION=false
ENABLE_PRE_MEETING_AGENT=false
ENABLE_POST_MEETING_AGENT=false
ENABLE_WINNING_PATTERN_CONTEXT=false
